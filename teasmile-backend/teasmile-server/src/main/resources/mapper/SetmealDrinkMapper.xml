<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.teasmile.mapper.SetmealDrinkMapper">
    <select id="getSetmealIdsByDrinkIds" resultType="java.lang.Long">
        select setmeal_id from setmeal_drink where drink_id in
        <foreach collection="drinkIds" item="drinkId" separator="," open="(" close=")">
            #{drinkId}
        </foreach>
    </select>

    <insert id="insertBatch" parameterType="list">
        insert into setmeal_drink
        (setmeal_id,drink_id,name,price,copies)
        values
        <foreach collection="setmealDrinkList" item="sd" separator=",">
            (#{sd.setmealId},#{sd.drinkId},#{sd.name},#{sd.price},#{sd.copies})
        </foreach>
    </insert>

</mapper>

<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.teasmile.mapper.DrinkFlavorMapper">
    <insert id="insertBatch">
        insert into drink_flavor (drink_id, name, value) VALUES
        <foreach collection="flavors" item="df" separator=",">
            (#{df.drinkId},#{df.name},#{df.value})
        </foreach>
    </insert>

    <delete id="deleteByDrinkIds">
        delete from drink_flavor where drink_id
        <foreach collection="drinkIds" open="(" close=")" separator="," item="drinkId">
            #{drinkId}
        </foreach>
    </delete>

</mapper>
